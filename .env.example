# Tu dien key tu Google AI Studio. Khong commit file .env.
GEMINI_API_KEY=

# Chi doi thanh true sau khi tu kiem tra project chua bat billing.
# Ung dung KHONG the tu xac minh billing tu API key.
GEMINI_FREE_TIER_CONFIRMED=false

# Tuy chon: nhap Requests per day (RPD) cua model trong Google AI Studio.
# Chi dung de uoc tinh tu luot sinh cua web local, khong gioi han API.
GEMINI_DAILY_REQUEST_LIMIT=

# Model co dinh: gemini-3.5-flash-lite. Moi chat co 2000 token.
# Khong co fallback tra phi / tim kiem / code execution.
